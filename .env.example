# Copy to .env and fill in before launch. Never commit .env.

# Vast.ai — create at https://console.vast.ai/manage-keys/
VAST_API_KEY=

# Hugging Face — accept gated model licenses first
HF_TOKEN=

# Spend guardrails (USD)
MAX_USD=180
MIN_CREDIT_USD=50

# Optional overrides
DISK_GB=400
WAIT_TIMEOUT_SEC=1500
MATRIX_TIMEOUT_SEC=28800
# Abort if no progress appears after start (seconds)
# MATRIX_STARTUP_GRACE_SEC=180
# SSH retries after attach (attempts × delay, default 20 × 4s)
# SSH_WAIT_ATTEMPTS=20
# SSH_WAIT_DELAY_SEC=4
# SSH PROGRESS.json considered stale after this many seconds (default 120)
# MATRIX_HEARTBEAT_STALE_SEC=120
# Remote install_stack pip timeouts (seconds)
# INSTALL_VLLM_TIMEOUT_SEC=600
# INSTALL_LLAMA_TIMEOUT_SEC=600
# LLM-only smoke: skip ComfyUI clone (~10–20 min saved per SKU)
# BAKEOFF_SKIP_COMFY=1
# Quick Qwen smoke (Spark + 5090): ./scripts/smoke_qwen.sh
#   or: uv run python scripts/02_run_bakeoff.py --preset qwen-spark-5090
# Preset env caps override MIN_CREDIT_USD / MAX_USD / MATRIX_TIMEOUT_SEC below.
TZ=Australia/Melbourne

# Team API key path (no SSH): VM clones harness at boot via --onstart
# BAKEOFF_GIT_URL=https://github.com/xuchenhaohth/gpu-bakeoff.git
# BAKEOFF_GIT_REF=main
# HF_RESULTS_REPO=your-username/gpu-bakeoff-results
